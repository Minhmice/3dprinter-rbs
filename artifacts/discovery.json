{
  "target": {
    "hostname": "mainsailos",
    "ip": "192.168.0.103",
    "port": 22,
    "primary_user": "kero",
    "additional_users": ["minhmice"]
  },
  "hardware": {
    "model": "Raspberry Pi 2 Model B Rev 1.1",
    "architecture": "armv7l",
    "cpu_cores": 4,
    "memory_mb": 1024,
    "mac_address": "b8:27:eb:ec:1f:e5"
  },
  "os": {
    "name": "Raspbian GNU/Linux",
    "version": "12 (bookworm)",
    "kernel": "6.12.25+rpt-rpi-v7",
    "family": "raspberry-pi-os",
    "distribution": "raspbian",
    "mainsailos_release": "2.0.0 (bookworm)",
    "image_source": "Raspberry Pi reference 2025-05-13 via pi-gen"
  },
  "storage": {
    "root_filesystem": "/dev/mmcblk0p2",
    "root_size_gb": 14.0,
    "root_used_gb": 8.9,
    "root_avail_gb": 4.2,
    "root_use_percent": 69,
    "boot_filesystem": "/dev/mmcblk0p1",
    "boot_mount": "/boot/firmware",
    "boot_size_mb": 510,
    "boot_used_mb": 99
  },
  "network": {
    "interfaces": [
      { "name": "eth0", "state": "UP", "ip": "192.168.0.103/24" },
      { "name": "tailscale0", "state": "UNKNOWN", "status": "logged_out" }
    ],
    "default_gateway": "192.168.0.1",
    "dns_nameservers": ["192.168.0.1"]
  },
  "installed_stack": {
    "nginx": {
      "version": "1.22.1",
      "binary": "/usr/sbin/nginx",
      "service": "nginx.service",
      "active": true,
      "listening_ports": [80],
      "active_sites": ["mainsail"],
      "web_root": "/home/kero/mainsail",
      "reverse_proxies": [
        { "path": "/websocket", "upstream": "http://127.0.0.1:7125/websocket" },
        { "path": "~ ^/(printer|api|access|machine|server)/", "upstream": "http://127.0.0.1:7125$request_uri" },
        { "path": "/webcam/", "upstream": "http://127.0.0.1:8080/" },
        { "path": "/webcam2/", "upstream": "http://127.0.0.1:8081/" },
        { "path": "/webcam3/", "upstream": "http://127.0.0.1:8082/" },
        { "path": "/webcam4/", "upstream": "http://127.0.0.1:8083/" }
      ]
    },
    "klipper": {
      "service": "klipper.service",
      "active": true,
      "user": "kero",
      "working_dir": "/home/kero/klipper",
      "python_venv": "/home/kero/klippy-env",
      "env_file": "/home/kero/printer_data/systemd/klipper.env"
    },
    "moonraker": {
      "service": "moonraker.service",
      "active": true,
      "user": "kero",
      "port": 7125,
      "working_dir": "/home/kero/moonraker",
      "python_venv": "/home/kero/moonraker-env",
      "env_file": "/home/kero/printer_data/systemd/moonraker.env"
    },
    "crowsnest": {
      "service": "crowsnest.service",
      "active": false,
      "state": "failed",
      "user": "kero",
      "binary": "/usr/local/bin/crowsnest",
      "env_file": "/home/kero/printer_data/systemd/crowsnest.env"
    },
    "sonar": {
      "service": "sonar.service",
      "active": true,
      "env_file": "/home/kero/printer_data/systemd/sonar.env"
    },
    "tailscale": {
      "service": "tailscaled.service",
      "active": true,
      "status": "installed_logged_out"
    }
  },
  "runtime_data_paths_excluded": [
    "/home/kero/printer_data/gcodes",
    "/home/kero/printer_data/logs",
    "/home/kero/printer_data/comms",
    "/home/kero/printer_data/database",
    "/home/kero/printer_data/timelapse"
  ]
}
